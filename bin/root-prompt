#!/usr/bin/env bash
#
# Gives a root shell a red [root] prompt and a dark red terminal background,
# set with OSC 11 and reset with OSC 111 when the shell exits. Run it as root:
#
#   sudo bin/root-prompt
#
# macOS: /var/root/.profile, which is empty from the start.
# Linux: /etc/profile.d/root-prompt.sh, for login shells; /root/.bashrc is
# left alone.
#

source "${0%/*}/functions.sh" || exit $?

check_root || exit $?

case "$(uname -s)" in
	Darwin)	profile="/var/root/.profile" ;;
	Linux)	profile="/etc/profile.d/root-prompt.sh" ;;
	*)	fail "Unsupported system: $(uname -s)" ;;
esac

cat > "$profile" <<'EOF' || fail "Writing $profile failed!"
# root-prompt: red PS1 + dark red terminal background
_R=$(printf '\033[1;31m')
_X=$(printf '\033[0m')
PS1="[${_R}root${_X}] \$PWD > "
unset _R _X
printf '\033]11;#2a0000\007'
trap 'printf "\033]111\007"' EXIT
EOF

log "The root prompt is in $profile"
