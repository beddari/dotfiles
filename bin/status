#!/usr/bin/env bash
#
# Shows whether each link is in place, the theme in use, whether every
# package in Brewfile is installed, on macOS the ssh-agent and its keys, on
# GNOME whether the settings in gnome/settings are in use and, on Ubuntu,
# whether the apt repositories in apt/ are installed.
#

source "${0%/*}/functions.sh" || exit $?

#
# Prints one line per link: ok, missing, or the other file it points at.
#
function print_links()
{
	local src dest state

	log "Links:"
	while read -r src dest; do
		if [[ "$(readlink "$dest" 2>/dev/null)" == "$root/$src" ]]; then
			state="ok"
		elif [[ -L "$dest" ]]; then
			state="-> $(readlink "$dest")"
		elif [[ -e "$dest" ]]; then
			state="not a link"
		else
			state="missing"
		fi
		printf "  %-48s %s\n" "${dest/#$HOME/~}" "$state"
	done < <(links)
}

#
# Prints the theme that local/bin/theme set last.
#
function print_theme()
{
	local link

	link="$(readlink "$HOME/.config/delta-theme.gitconfig" 2>/dev/null)"
	link="${link##*/delta-}"
	log "Theme: ${link%.gitconfig}"
}

#
# Prints whether the packages in Brewfile and the VSCodium extensions in
# vscodium/extensions.txt are installed.
#
function print_packages()
{
	if ! brew bundle check --file="$root/Brewfile" >/dev/null 2>&1; then
		log "Packages: some are missing. Run: task brew"
	elif command -v codium >/dev/null &&
	     [[ -n "$(missing_codium_extensions)" ]]; then
		log "Packages: some VSCodium extensions are missing. Run: task brew"
	else
		log "Packages: all installed"
	fi
}

#
# Prints the state of the ssh-agent LaunchAgent, whether apps started by
# launchd use it, and the keys it holds.
#
function print_ssh_agent()
{
	local state

	state="$(launchctl print "gui/$(id -u)/com.brew.ssh-agent" 2>/dev/null |
		awk '$1 == "state" { print $3; exit }')"
	log "ssh-agent: ${state:-not loaded. Run: task link}"
	if [[ "$(launchctl getenv SSH_AUTH_SOCK)" == "$HOME/.ssh/agent.sock" ]]; then
		echo "  Apps opened from the Dock use it."
	else
		echo "  Apps opened from the Dock use another agent. Run: task link"
	fi
	SSH_AUTH_SOCK="$HOME/.ssh/agent.sock" ssh-add -l 2>&1 | sed 's/^/  /'
}

#
# Prints one line per setting in gnome/settings: ok, or the value in use.
#
function print_gnome()
{
	local schema key value current

	log "GNOME settings:"
	while read -r schema key value; do
		current="$(gsettings get "$schema" "$key" 2>&1)"
		if [[ "$current" == "$value" ]]; then
			current="ok"
		fi
		printf "  %-48s %s\n" "$schema $key" "$current"
	done < <(gnome_settings)
}

#
# Prints one line per file in apt/: ok, missing, or differs from the one
# installed. Then the keys in trusted.gpg.d, which may sign any repository.
#
function print_apt()
{
	local src dest state

	log "apt repositories:"
	for src in "$root"/apt/*; do
		dest="/etc/apt/sources.list.d/${src##*/}"
		[[ "${src##*/}" == "$brave_keyring" ]] &&
			dest="/usr/share/keyrings/$brave_keyring"
		if   cmp -s "$src" "$dest"; then state="ok"
		elif [[ -e "$dest" ]]; then state="differs. Run: task apt-repos"
		else state="missing. Run: task apt-repos"
		fi
		printf "  %-48s %s\n" "$dest" "$state"
	done
	echo "  Trusted for every repository:" /etc/apt/trusted.gpg.d/*
}

print_links
print_theme
print_packages
[[ "$(uname -s)" == "Darwin" ]] && print_ssh_agent
command -v gsettings >/dev/null && print_gnome
[[ -d /etc/apt/sources.list.d ]] && print_apt
exit 0
