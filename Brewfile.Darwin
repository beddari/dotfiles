# Extensions are installed with the `codium` CLI (brew bundle falls back to it
# when `code` is absent), so they come from Open VSX, not the MS Marketplace.
# MS-only extensions (copilot-chat, ms-vscode-remote.*, tilt-dev.tiltfile) are
# not publishable there and have been dropped.
vscode "bpruitt-goddard.mermaid-markdown-syntax-highlighting"
vscode "dnut.rewrap-revived"
vscode "golang.go"
vscode "jeanp413.open-remote-ssh"
vscode "opentofu.vscode-opentofu"
vscode "pomdtr.excalidraw-editor"
vscode "pomdtr.markdown-kroki"
vscode "shardulm94.trailing-spaces"
vscode "terrastruct.d2"
