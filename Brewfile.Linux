# VSCodium itself is not installable from Homebrew on Linux (casks are macOS
# only) — install it from the VSCodium apt/rpm repo first, so that `codium` is
# on PATH. brew bundle then drives extension installs through it, which means
# they come from Open VSX, not the MS Marketplace. MS-only extensions
# (copilot-chat, ms-vscode-remote.*, tilt-dev.tiltfile) are not publishable
# there and have been dropped.
vscode "bpruitt-goddard.mermaid-markdown-syntax-highlighting"
vscode "dnut.rewrap-revived"
vscode "golang.go"
vscode "jeanp413.open-remote-ssh"
vscode "opentofu.vscode-opentofu"
vscode "pomdtr.excalidraw-editor"
vscode "pomdtr.markdown-kroki"
vscode "shardulm94.trailing-spaces"
vscode "terrastruct.d2"
