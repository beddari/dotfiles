# Homebrew
if [[ "$(uname)" == "Darwin" ]]; then
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$HOME/go/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"

export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

# Environment
if [[ "$(uname)" == "Darwin" ]]; then
    # No SSH_SK_PROVIDER: it would hide the YubiKey. Secure Enclave keys get
    # their provider per key from `ssh-enclave load` instead.
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    # The agent forgets enclave keys on restart; re-adding needs no touch.
    if command -v ssh-enclave >/dev/null &&
        ! ssh-add -l 2>/dev/null | grep -q 'ECDSA-SK)$'; then
        ssh-enclave load 2>/dev/null
    fi
    # Remap non-breaking space (Option+Space on Norwegian keyboard) to regular space
    bindkey -s '\xc2\xa0' ' '
    # Set config folder for e.g sops
    export XDG_CONFIG_HOME="$HOME/.config"
fi
export EDITOR=vim
export LESS='-FRXx4'

# History
HISTFILE=~/.histfile
HISTSIZE=200000
SAVEHIST=200000
HISTORY_RETENTION_DAYS=21
HISTORY_PRUNE_INTERVAL_SECONDS=86400

# Keep rich, shared history and ensure Ctrl-R works across keymaps.
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
bindkey '^R' history-incremental-search-backward
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' kill-whole-line
bindkey -M viins '^W' backward-kill-word

# Keep only recent timestamped history entries in HISTFILE.
_prune_history_file() {
    [[ -s "$HISTFILE" ]] || return 0

    local prune_state_file="${HISTFILE}.prune-state"
    local lock_file="${HISTFILE}.prune-lock"
    local last_prune=0
    local cutoff
    local tmp_file="${HISTFILE}.tmp.$$"

    if [[ -r "$prune_state_file" ]]; then
        read -r last_prune < "$prune_state_file"
        [[ "$last_prune" == <-> ]] || last_prune=0
    fi

    (( EPOCHSECONDS - last_prune >= HISTORY_PRUNE_INTERVAL_SECONDS )) || return 0

    # Non-blocking lock: skip prune if another shell is already pruning.
    if ! ( set -o noclobber; : > "$lock_file" ) 2>/dev/null; then
        return 0
    fi

    cutoff=$(( EPOCHSECONDS - HISTORY_RETENTION_DAYS * 86400 ))

    if awk -v cutoff="$cutoff" '
        /^: [0-9]+:[0-9]+;/ {
            if (match($0, /^: ([0-9]+):[0-9]+;/, m) && m[1] >= cutoff) {
                print
            }
            next
        }
        { print }
    ' "$HISTFILE" > "$tmp_file"; then
        mv "$tmp_file" "$HISTFILE"
        print -r -- "$EPOCHSECONDS" > "$prune_state_file"
    else
        rm -f "$tmp_file"
    fi

    rm -f "$lock_file"
}
_prune_history_file

# Cursor shape: blinking bar
echo -ne '\e[5 q'

# Prompt
eval "$(starship init zsh)"

# Window title
function _set_window_title() {
    if [[ -n "$SSH_CONNECTION" ]]; then
        print -Pn "\e]0;ssh → ${USER}@${HOST%%.*}: ${PWD/#$HOME/~}\a"
    else
        print -Pn "\e]0;${PWD/#$HOME/~}\a"
    fi
}
precmd_functions+=(_set_window_title)

# Dircolors
if [[ -f ~/.dircolors ]]; then
    if command -v gdircolors &>/dev/null; then
        eval "$(gdircolors ~/.dircolors)"
        alias ls='gls --color=auto'
    elif command -v dircolors &>/dev/null; then
        eval "$(dircolors ~/.dircolors)"
        alias ls='ls --color=auto'
    fi
fi

# Completions
if command -v brew &>/dev/null; then
    fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit
compinit

# zmx
if command -v zmx &>/dev/null; then
    eval "$(zmx completions zsh)"
fi

# Forward local zmx sessions to a remote host over ssh -R, so an agent
# there drives this Mac with plain zmx run/write/history/send/wait.
# The remote side cannot create sessions here; forward as many as it needs.
#   zmx-portal [host] [session...]   default: 192.168.0.3 macos-1 macos-2
# The remote zmx must match the local version (same IPC protocol).
function zmx-portal() {
    local host="${1:-192.168.0.3}"
    local sessions=("${@:2}")
    local ldir rdir s
    local forwards=()

    (( $#sessions )) || sessions=(macos-1 macos-2)
    ldir="$(zmx version | awk '$1 == "socket_dir" { print $2 }')" || return
    for s in $sessions; do
        if ! zmx list --short 2>/dev/null | grep -qx "$s"; then
            zmx run "$s" -d true || return
            zmx set "$s" role=portal
        fi
    done

    # Ask the remote zmx for its socket dir and clear stale sockets,
    # since StreamLocalBindUnlink only applies to -R in the remote sshd_config.
    rdir="$(ssh "$host" \
        'd=$(zmx version 2>/dev/null | awk '\''$1 == "socket_dir" { print $2 }'\'')
         d=${d:-${ZMX_DIR:-${XDG_RUNTIME_DIR:?}/zmx}} &&
         mkdir -p -m 700 "$d" && cd "$d" && rm -f '"${(j: :)${(@q)sessions}}"' && echo "$d"')" || return
    [[ -n "$rdir" ]] || { echo "zmx-portal: no socket_dir on $host" >&2; return 1; }

    for s in $sessions; do
        forwards+=(-R "$rdir/$s:$ldir/$s")
    done
    echo "zmx-portal: $sessions -> $host:$rdir (Ctrl-C to close)"
    ssh -N -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes $forwards "$host"
}

# Install local TERM terminfo on a remote host
function terminfo-install() {
    infocmp "$TERM" | ssh "$@" -- tic -x -
}
compdef terminfo-install=ssh
