# PATH, for every shell. zshenv sources it, so that a command given to ssh
# finds what Homebrew and ~/.local/bin hold; zshrc and bashrc source it
# again, since a login shell on macOS reorders PATH after zshenv.

# Homebrew
if [[ "$(uname)" == "Darwin" ]]; then
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$HOME/go/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
