[alias]
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
[commit]
  verbose = true
  gpgSign = true
[core]
  pager = delta
[delta]
  navigate = true
  syntax-theme = ansi
  line-numbers = true
[diff]
  colorMoved = default
[difftool]
  prompt = false
[fetch]
  prune = true
[github]
  user = beddari
[gpg]
  format = ssh
[help]
  autocorrect = 1
[include]
  path = ~/.gitconfig.local
  path = ~/.config/delta-theme.gitconfig
[init]
  defaultBranch = main
[interactive]
  diffFilter = delta --color-only
[merge]
  conflictstyle = diff3
[pull]
  rebase = true
[rebase]
  autoStash = true
[tag]
  forceSignAnnotated = true
[user]
  name = Jan Ivar Beddari
  email = code@beddari.net
[gpg "ssh"]
  # Sign with the YubiKey: the first ed25519-sk key in the agent. Keys in the
  # Secure Enclave are ecdsa-sk, so they never sign. With no such key in the
  # agent, signing fails; ssh-add the YubiKey's key.
  defaultKeyCommand = sh -c \"ssh-add -L | grep ^sk-ssh-ed25519@openssh.com | head -1 | sed s/^/key::/\"
  allowedSignersFile = ~/.config/git/allowed_signers
