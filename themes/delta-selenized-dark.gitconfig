[delta]
        dark = true
        syntax-theme = ansi
        minus-style = syntax "#3a1517"
        minus-emph-style = syntax "#5c1f22"
        plus-style = syntax "#1a3320"
        plus-emph-style = syntax "#264a2e"
        line-numbers-minus-style = "#FD564E"
        line-numbers-plus-style = "#80B83C"
        line-numbers-zero-style = "#ADBCBC"
        hunk-header-decoration-style = "#ADBCBC" box
        hunk-header-style = file line-number syntax
        file-style = "#0096F5" bold
        file-decoration-style = "#0096F5" ul
