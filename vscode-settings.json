{
    "editor.fontFamily": "Intel One Mono",
    "editor.fontWeight": "normal",
    "editor.fontSize": 15,
    "editor.lineHeight": 19,
    "editor.renderWhitespace": "all",
    "editor.minimap.enabled": false,

    "window.titleBarStyle": "custom",
    "window.customTitleBarVisibility": "auto",

    "workbench.activityBar.location": "bottom",
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.startupEditor": "none",
    "workbench.welcomePage.walkthroughs.openOnInstall": false,

    "git.confirmSync": false,

    "telemetry.telemetryLevel": "off",
    "update.mode": "manual",
    "update.showReleaseNotes": false,
    "update.statusBar": "hidden",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "npm.fetchOnlinePackageInfo": false,

    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80,
        "editor.rulers": [80]
    },

    "chat.tools.urls.autoApprove": {
        "https://codeberg.org": true,
        "https://forgejo.org": true,
        "https://github.com": true,
        "https://*.githubusercontent.com": true,
        "https://gitlab.com": true,
        "https://*.gitea.com": true,
        "https://*.visualstudio.com": true,
        "https://*.golang.org": true,
        "https://*.go.dev": true,
        "https://*.python.org": true,
        "https://*.kubernetes.io": true,
        "https://*.cncf.io": true,
        "https://helm.sh": true,
        "https://*.prometheus.io": true,
        "https://*.grafana.com": true,
        "https://thanos.io": true,
        "https://*.cilium.io": true,
        "https://fluxcd.io": true,
        "https://*.cert-manager.io": true,
        "https://etcd.io": true,
        "https://containerd.io": true,
        "https://*.opentelemetry.io": true,
        "https://envoyproxy.io": true,
        "https://coredns.io": true,
        "https://*.hashicorp.com": true,
        "https://opentofu.org": true,
        "https://registry.terraform.io": true,
        "https://*.nginx.org": true,
        "https://*.traefik.io": true,
        "https://*.nats.io": true,
        "https://*.postgresql.org": true,
        "https://*.redis.io": true,
        "https://*.mariadb.org": true,
        "https://*.elastic.co": true,
        "https://*.docker.com": true,
        "https://*.podman.io": true,
        "https://*.kernel.org": true,
        "https://*.archlinux.org": true,
        "https://*.debian.org": true,
        "https://*.fedoraproject.org": true,
        "https://man7.org": true,
        "https://*.freedesktop.org": true,
        "https://systemd.io": true,
        "https://letsencrypt.org": true,
        "https://*.wireguard.com": true,
        "https://zitadel.com": true,
        "https://woodpecker-ci.org": true,
        "https://*.matrix.org": true,
        "https://*.nextcloud.com": true,
        "https://*.apache.org": true,
        "https://*.ansible.com": true,
        "https://*.readthedocs.io": true,
        "https://openbao.org": true,
        "https://cloudevents.io": true,
        "https://linuxcontainers.org": true,
        "https://*.talos.dev": true,
        "https://*.siderolabs.com": true,
        "https://gohugo.io": true,
        "https://*.launchpad.net": true,
        "https://en.wikipedia.org": true,
        "https://en.wiktionary.org": true,
        "https://www.rfc-editor.org": {
            "approveRequest": true,
            "approveResponse": false
        }
    },
    "chat.tools.terminal.autoApprove": {
        "git": true,
        "diff": true
    },
    "chat.viewSessions.orientation": "stacked"
}
