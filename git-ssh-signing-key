#!/bin/sh
# git gpg.ssh.defaultKeyCommand helper.
#
# Emits the first ssh-agent key in the `key::` form git requires, so commit
# signing uses whatever key the (possibly forwarded) agent holds — no
# host-specific user.signingkey hardcoded in dotfiles.
#
# Install:
#   chmod +x git-ssh-signing-key            # e.g. into ~/.local/bin/
#   git config --global gpg.format ssh
#   git config --global gpg.ssh.defaultKeyCommand "$HOME/.local/bin/git-ssh-signing-key"
#   git config --global --unset user.signingkey   # let this command provide it
#
# git splits the command on whitespace and runs it without a shell, so the
# value must be a single absolute path (no ~, no inline pipeline).
ssh-add -L 2>/dev/null | head -n1 | sed 's/^/key::/'
