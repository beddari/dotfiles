[alias]
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
[commit]
  verbose = true
  gpgSign = true
[core]
  pager = delta
[delta]
  navigate = true
  syntax-theme = ansi
  line-numbers = true
[diff]
  colorMoved = default
[difftool]
  prompt = false
[fetch]
  prune = true
[github]
  user = beddari
[gpg]
  program = gpg
  format = ssh
[help]
  autocorrect = 1
[include]
  path = ~/.gitconfig.local
  path = ~/.config/delta-theme.gitconfig
[init]
  defaultBranch = main
[interactive]
  diffFilter = delta --color-only
[merge]
  conflictstyle = diff3
[pull]
  rebase = true
[rebase]
  autoStash = true
[tag]
  forceSignAnnotated = true
[user]
  name = Jan Ivar Beddari
  email = code@beddari.net
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
